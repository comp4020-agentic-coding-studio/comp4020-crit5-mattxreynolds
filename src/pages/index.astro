---
import "../styles/styles.css";
import { LEVELS } from "../game/levels";
import { screenHTML } from "../game/render";
import { startRun } from "../game/state";

// The board that ships in the HTML comes from the same renderer the browser
// uses, so the page is never an empty div waiting on JavaScript and the two
// can't drift apart.
const opening = screenHTML(startRun(LEVELS));
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const favicon = `${base}forethought-favicon.svg`;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forethought</title>
    <meta
      name="description"
      content="A turn-based golf puzzle: spend a hand of movement cards to roll the ball into the hole across an isometric course."
    />

    <!--
      The link-preview card: public/card.png, 1200x630. The URL resolves
      against this page, like any link. No og:title/og:description: scrapers
      fall back to the <title> and description above.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={favicon} type="image/svg+xml" sizes="any" />
    <link rel="shortcut icon" href={favicon} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="vh">
      <h1>Forethought</h1>
      <nav aria-label="Primary">
        <a href="./">Forethought</a>
      </nav>
    </header>
    <main id="game" set:html={opening}></main>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
